{
  "name": "yogo75-codex-status",
  "version": "0.9.0-beta.14",
  "description": "Local Codex status animations for ATK YOGO 75 PRO",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node launcher.cjs",
    "test": "node --test test/*.test.cjs",
    "doctor": "node cli.cjs doctor",
    "play": "node cli.cjs play",
    "pack:source": "node scripts/package.cjs source",
    "pack:windows": "node scripts/package.cjs windows",
    "pack:macos": "node scripts/package.cjs macos",
    "desktop": "electron .",
    "desktop:prepare": "node scripts/desktop-prepare.cjs",
    "build:windows": "npm run desktop:prepare && electron-builder --config electron-builder.json --win --x64 --publish never",
    "build:macos": "npm run desktop:prepare && electron-builder --config electron-builder.json --mac --publish never"
  },
  "dependencies": {
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.20",
    "camera-controls": "3.1.2",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "three": "0.186.0"
  },
  "main": "desktop/main.cjs",
  "productName": "YOGO Studio",
  "author": "YOGO Studio"
}
